{
  "name": "@repo/db",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "bun run db:generate:postgres && bun run db:generate:mongo",
    "db:generate:postgres": "prisma generate --schema=./prisma/postgres/schema.prisma",
    "db:generate:mongo": "prisma generate --schema=./prisma/mongo/schema.prisma",
    "db:push:postgres": "prisma db push --schema=./prisma/postgres/schema.prisma",
    "db:push:mongo": "prisma db push --schema=./prisma/mongo/schema.prisma",
    "db:studio:postgres": "prisma studio --schema=./prisma/postgres/schema.prisma",
    "db:studio:mongo": "prisma studio --schema=./prisma/mongo/schema.prisma"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^7.3.0",
    "dotenv": "^16.4.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "^7.3.0"
  }
}
