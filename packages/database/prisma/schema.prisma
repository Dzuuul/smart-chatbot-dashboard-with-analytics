generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum chatbot_flow_node_type {
  START
  MESSAGE
  QUESTION
  ACTION
  END
}

enum chatbot_flow_node_edge_condition_type {
  TEXT_MATCH
  BUTTON
  FALLBACK
}

enum message_sender_type {
  USER
  BOT
  ADMIN
}

enum message_type {
  TEXT
  IMAGE
  VIDEO
  FILE
  LOCATION
  CONTACT
  BUTTON
  LIST
  FLOW
}

model roles {
  id         String    @id @default(cuid()) // Menggunakan CUID agar lebih aman di URL
  name       String    @unique
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? // Nullable field for soft delete

  // Relasi: satu role bisa memiliki banyak users
  users users[]
}

model users {
  id         String    @id @default(cuid())
  role_id    String
  email      String    @unique
  password   String
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? // Nullable field for soft delete

  // Relasi: setiap user memiliki satu role
  role roles @relation(fields: [role_id], references: [id])
}

model contacts {
  id           String    @id @default(cuid())
  phone_number String    @unique
  name         String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime? // Nullable field for soft delete

  conversations conversations[]
}

model conversations {
  id         String    @id @default(cuid())
  contact_id String
  status     String
  started_at DateTime
  ended_at   DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime? // Nullable field for soft delete

  contact  contacts   @relation(fields: [contact_id], references: [id])
  messages messages[]

  @@index([contact_id], name: "conversation_contact_idx")
  @@index([status], name: "conversation_status_idx")
}

model messages {
  id               String              @id @default(cuid())
  conversation_id  String
  sender_type      message_sender_type
  message_type     message_type
  message_text     String?
  meta_message_id  String?
  response_time_ms Int?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  deleted_at       DateTime? // Nullable field for soft delete

  conversation conversations @relation(fields: [conversation_id], references: [id])

  @@index([conversation_id], name: "message_conversation_idx")
  @@index([sender_type], name: "message_sender_type_idx")
  @@index([created_at], name: "message_created_at_idx")
}

model chatbot_flows {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime? // Nullable field for soft delete

  chatbot_flow_nodes   chatbot_flow_nodes[]
  chatbotFlowNodeEdges chatbot_flow_node_edges[]
}

model chatbot_flow_nodes {
  id              String                 @id @default(cuid())
  chatbot_flow_id String
  node_type       chatbot_flow_node_type
  content         String
  metadata        Json?
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  deleted_at      DateTime? // Nullable field for soft delete

  chatbot_flow chatbot_flows             @relation(fields: [chatbot_flow_id], references: [id])
  sourceEdges  chatbot_flow_node_edges[] @relation("SourceEdges")
  targetEdges  chatbot_flow_node_edges[] @relation("TargetEdges")
}

model chatbot_flow_node_edges {
  id              String                                @id @default(cuid())
  chatbot_flow_id String
  source_node_id  String
  target_node_id  String
  condition_type  chatbot_flow_node_edge_condition_type
  condition_value String
  created_at      DateTime                              @default(now())
  updated_at      DateTime                              @updatedAt
  deleted_at      DateTime? // Nullable field for soft delete

  chatbot_flow chatbot_flows      @relation(fields: [chatbot_flow_id], references: [id])
  source_node  chatbot_flow_nodes @relation("SourceEdges", fields: [source_node_id], references: [id])
  target_node  chatbot_flow_nodes @relation("TargetEdges", fields: [target_node_id], references: [id])
}

model message_metrics {
  id                   String    @id @default(cuid())
  date                 DateTime
  total_messages       Int
  total_users          Int
  avg_response_time_ms Int
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime? // Nullable field for soft delete

  @@index([date], name: "message_metrics_date_idx")
}
