{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "$JWT_SECRET",
    "$JWT_EXPIRATION",
    "$JWT_REFRESH_SECRET",
    "$JWT_REFRESH_EXPIRATION",
    "$DATABASE_URL",
    "$FRONTEND_URL",
    "$API_PORT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    }
  }
}
